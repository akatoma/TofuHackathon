  m_Name: 
  m_EditorClassIdentifier: 
  smtpHost: smtp.gmail.com
  smtpPort: 587
  smtpUser: toofuhakkason@gmail.com
  smtpPassword: uzategbwbnqaokib
  fromAddress: toofuhakkason@gmail.com
  fromDisplayName: "\u753A\u7530\u3055\u3084"
  templates:
  - subject: "\u3042\u306E\u3001\u5148\u8F29\u3001\u3053\u308C\u3067\u5408\u3063\u3066\u307E\u3059\u304B\uFF1F"
    body: "\u3055\u3063\u304D\u306F\u30E1\u30A2\u30C9\u4EA4\u63DB\u3057\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\u7DCA\u5F35\u3057\u3059\u304E\u3066\u3001\u4F55\u3092\u9001\u308C\u3070\u3044\u3044\u304B3\u56DE\u304F\u3089\u3044\u66F8\u304D\u76F4\u3057\u307E\u3057\u305F\u2026\u3002\u3068\u308A\u3042\u3048\u305A\u3001\u3053\u308C\u3067\u5C4A\u3044\u3066\u3044\u308B\u304B\u78BA\u8A8D\u3057\u305F\u304F\u3066\u9001\u3063\u3061\u3083\u3044\u307E\u3057\u305F\uFF01"
  - subject: "\u672C\u65E5\u306F\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01"
    body: "\u3053\u3093\u3070\u3093\u306F\u3002\u672C\u65E5\u306F\u30E1\u30FC\u30EB\u30A2\u30C9\u30EC\u30B9\u3092\u4EA4\u63DB\u3057\u3066\u3044\u305F\u3060\u304D\u3001\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\u4ECA\u5F8C\u3068\u3082\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3044\u305F\u3057\u307E\u3059\u2026\u2026\u306A\u3093\u3066\u3001\u304B\u305F\u3059\u304E\u308B\u3088\u306D\uFF08\u7B11\uFF09\u3002\u666E\u901A\u306B\u304A\u8A71\u3057\u3067\u304D\u305F\u3089\u5B09\u3057\u3044\u3067\u3059\uFF01"
  - subject: "\u3084\u3063\u305F\u30FC\uFF01\uFF01"
    body: "\u3084\u3063\u307B\u30FC\u30FC\uFF01\uFF01\uFF01\u3064\u3044\u306B\u30E1\u30A2\u30C9\u4EA4\u63DB\u3067\u304D\u305F\u301C\uFF01\uFF01\uFF01\u305A\u3063\u3068\u52C7\u6C17\u51FA\u305B\u306A\u304F\u3066\u3001\u4ECA\u65E5\u58F0\u304B\u3051\u3089\u308C\u3066\u672C\u5F53\u306B\u5B09\u3057\u304B\u3063\u305F\uFF01\u3053\u308C\u304B\u3089\u3044\u3063\u3071\u3044\u30E1\u30FC\u30EB\u3057\u3066\u3082\u3044\u3044\u3088\u306D\uFF01\uFF1F"
  - subject: "\u3068\u3069\u3044\u3066\u308B\u304B\u306A(^^)"
    body: "\u30E1\u30A2\u30C9\u4EA4\u63DB\u3042\u308A\u304C\u3068\u266A\u3061\u3083\u3093\u3068\u5C4A\u3044\u3066\u308B\u304B\u5FC3\u914D\u3067\u9001\u3063\u3061\u3083\u3063\u305F(\u7B11)
      \u660E\u65E5\u304B\u3089\u5B66\u6821\u3067\u304A\u8A71\u3057\u3067\u304D\u305F\u3089\u5B09\u3057\u3044\uFF01"
  - subject: "\u8CEA\u554F\u3057\u3066\u3082\u3044\u3044\u3067\u3059\u304B\uFF1F"
    body: "\u3053\u3093\u306B\u3061\u306F\uFF01\u3055\u3063\u305D\u304F\u3067\u60AA\u3044\u3093\u3067\u3059\u3051\u3069\u3001\u4F11\u307F\u306E\u65E5\u3063\u3066\u4F55\u3057\u3066\u308B\u3053\u3068\u304C\u591A\u3044\u3067\u3059\u304B\uFF1F\u79C1\u3001\u541B\u306E\u3053\u3068\u3082\u3063\u3068\u77E5\u308A\u305F\u3044\u3067\u3059\uFF01"
  - subject: "\u305A\u3063\u3068\u8A71\u3057\u304B\u3051\u305F\u304B\u3063\u305F\u3067\u3059"
    body: "\u3053\u3093\u3070\u3093\u306F\u3002\u5B9F\u306F\u305A\u3063\u3068\u524D\u304B\u3089\u3001\u3042\u306A\u305F\u3068\u304A\u8A71\u3057\u3057\u3066\u307F\u305F\u3044\u306A\u3063\u3066\u601D\u3063\u3066\u307E\u3057\u305F\u3002\u4ECA\u65E5\u58F0\u3092\u304B\u3051\u3066\u3044\u305F\u3060\u3051\u3066\u3001\u3059\u3054\u304F\u5B09\u3057\u304B\u3063\u305F\u3067\u3059\u3002\u3053\u308C\u304B\u3089\u3082\u3063\u3068\u4EF2\u826F\u304F\u306A\u308C\u305F\u3089\u5B09\u3057\u3044\u3067\u3059\u3002"
  - subject: "\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3057\u307E\u3059"
    body: "\u30E1\u30A2\u30C9\u4EA4\u63DB\u3057\u3066\u3044\u305F\u3060\u304D\u3001\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\u3053\u308C\u304B\u3089\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u3057\u307E\u3059\uFF01"
  - subject: "\u304B\u3063\u3053\u3088\u304B\u3063\u305F\u3067\u3059"
    body: "\u7A81\u7136\u306E\u30E1\u30FC\u30EB\u5931\u793C\u3057\u307E\u3059\u3002\u6628\u65E5\u3001\u3042\u306A\u305F\u304C\u6575\u3092\u5012\u3059\u59FF\u3092\u898B\u3066\u3001\u6B63\u76F4\u304B\u3063\u3053\u3044\u3044\u3068\u601D\u3063\u3066\u3057\u307E\u3044\u307E\u3057\u305F\u3002\u3042\u3093\u306A\u77AC\u9593\u3001\u666E\u901A\u306F\u4F53\u304C\u52D5\u304B\u306A\u3044\u3068\u601D\u3046\u306E\u3067\u3059\u304C\u2026\u3002\u9023\u7D61\u5148\u3092\u4EA4\u63DB\u3057\u3066\u3044\u305F\u3060\u304D\u3001\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
  - subject: "\u6628\u65E5\u306F\u672C\u5F53\u306B\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F"
    body: "\u6628\u65E5\u306E\u3053\u3068\u3001\u307E\u3060\u4FE1\u3058\u3089\u308C\u307E\u305B\u3093\u3002\u3042\u3093\u306A\u72B6\u6CC1\u3067\u5168\u304F\u6016\u304C\u3089\u305A\u306B\u52D5\u3051\u308B\u306A\u3093\u3066\u3001\u672C\u5F53\u306B\u3059\u3054\u3044\u3067\u3059\u3002\u52A9\u3051\u3066\u3044\u305F\u3060\u3044\u3066\u3001\u5FC3\u304B\u3089\u611F\u8B1D\u3057\u3066\u3044\u307E\u3059\u3002"
  - subject: "\u6628\u65E5\u306F\u672C\u5F53\u306B\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F"
    body: "\u6628\u65E5\u306E\u3053\u3068\u3001\u307E\u3060\u4FE1\u3058\u3089\u308C\u307E\u305B\u3093\u3002\u3042\u3093\u306A\u72B6\u6CC1\u3067\u5168\u304F\u6016\u304C\u3089\u305A\u306B\u52D5\u3051\u308B\u306A\u3093\u3066\u3001\u672C\u5F53\u306B\u3059\u3054\u3044\u3067\u3059\u3002\u52A9\u3051\u3066\u3044\u305F\u3060\u3044\u3066\u3001\u5FC3\u304B\u3089\u611F\u8B1D\u3057\u3066\u3044\u307E\u3059\u3002"
  subject: "\u3010\u79F0\u53F7\u7372\u5F97\u3011\u30B2\u30FC\u30E0\u30AF\u30EA\u30A2\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01"
  body: "\u3053\u306E\u5EA6\u306F\u30B2\u30FC\u30E0\u30AF\u30EA\u30A2\u3001\u304A\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01\n\u3042\u306A\u305F\u306B\u79F0\u53F7\u300C\u25CB\u25CB\u300D\u3092\u8D08\u308A\u307E\u3059\u3002"
